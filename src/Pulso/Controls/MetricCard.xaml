<UserControl x:Class="Pulso.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Pulso.Controls"
             MinHeight="132">
  <Border Background="{StaticResource Card}" CornerRadius="14" Padding="0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="Stripe" Background="{StaticResource Off}" CornerRadius="14,0,0,14"/>
      <StackPanel Grid.Column="1" Margin="14,12,8,12">
        <TextBlock x:Name="TitleBlock" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
        <TextBlock x:Name="ValueBlock" Foreground="{StaticResource Text}" FontSize="30" FontWeight="Bold" Text="—"/>
        <TextBlock x:Name="SubBlock" Foreground="{StaticResource Muted}" FontSize="12"/>
        <TextBlock x:Name="HintBlock" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
      <c:Sparkline x:Name="Spark" Grid.Column="2" Margin="8,16,14,16"/>
    </Grid>
  </Border>
</UserControl>
