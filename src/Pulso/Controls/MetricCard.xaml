<UserControl x:Class="Pulso.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Pulso.Controls"
             MinHeight="150">
  <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
          CornerRadius="10" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- cabeçalho: título + subtítulo à esquerda, selo de status à direita (só nos cards Gauge) -->
      <Grid Grid.Row="0" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="TitleBlock" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource FontBodySemiBold}" FontSize="12"/>
          <TextBlock x:Name="SubBlock" Foreground="{DynamicResource Muted}" FontSize="11" Opacity="0.85" Margin="0,2,0,0"/>
        </StackPanel>
        <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10"
                Padding="9,3" BorderThickness="1" Visibility="Collapsed">
          <TextBlock x:Name="StatusText" FontFamily="{StaticResource FontBodySemiBold}" FontSize="10.5"/>
        </Border>
      </Grid>

      <!-- gauge/anel + número central, e o texto de contexto ao lado -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid x:Name="GaugeCell" Width="104" Height="104" Margin="0,0,16,0">
          <c:RadialGauge x:Name="Gauge" Thickness="10"/>
          <TextBlock x:Name="ValueBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource Text}" FontFamily="{StaticResource FontDisplaySemiBold}"
                     FontSize="22" Text="—"/>
        </Grid>
        <TextBlock x:Name="HintBlock" Foreground="{DynamicResource Muted}" FontSize="12.5"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>

      <c:Sparkline x:Name="Spark" Grid.Row="2" Height="30" Margin="0,10,0,0"/>

      <!-- colchetes de canto (decoração de marca), cor definida por AccentBrush -->
      <Path x:Name="BracketTL" Data="M0,10 L0,0 L10,0" Stroke="{DynamicResource Off}" StrokeThickness="1.6"
            Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Opacity="0.9"/>
      <Path x:Name="BracketBR" Data="M0,0 L10,0 L10,10" Stroke="{DynamicResource Off}" StrokeThickness="1.6"
            Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Opacity="0.9"/>
    </Grid>
  </Border>
</UserControl>
