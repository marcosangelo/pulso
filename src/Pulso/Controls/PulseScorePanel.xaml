<UserControl x:Class="Pulso.Controls.PulseScorePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Pulso.Controls">
  <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
          CornerRadius="10" Padding="22,18">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- gauge + nota -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="150">
        <Grid Width="92" Height="92">
          <c:RadialGauge x:Name="Gauge" Thickness="10"/>
          <TextBlock x:Name="ScoreText" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontDisplaySemiBold}" FontSize="30" Foreground="{DynamicResource Text}" Text="—"/>
        </Grid>
        <TextBlock Text="PULSO SCORE" FontFamily="{StaticResource FontBodySemiBold}" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,8,0,2"/>
        <TextBlock x:Name="ScoreCaption" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}" Margin="18,4"/>

      <!-- onda "batimento do sistema" -->
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock Text="PULSO DO SISTEMA" FontFamily="{StaticResource FontBodySemiBold}" FontSize="11"
                   Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
        <c:Sparkline x:Name="Wave" Height="56"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
