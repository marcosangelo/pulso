<UserControl x:Class="Pulso.Controls.ThemeSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="SwatchOption" TargetType="RadioButton">
      <Setter Property="GroupName" Value="PulsoTheme"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Field}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <ToggleButton x:Name="Toggle" Cursor="Hand" Focusable="False"
                  IsChecked="{Binding IsOpen, ElementName=Flyout, Mode=TwoWay}">
      <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Width="34" Height="34" CornerRadius="8"
                  Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource AccentCpuColor}" Offset="0"/>
                  <GradientStop Color="{DynamicResource AccentGpuColor}" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </ToggleButton.Template>
    </ToggleButton>

    <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Margin="0,6,0,0">
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="10">
        <StackPanel Width="200">
          <TextBlock Text="APARÊNCIA" FontFamily="{StaticResource FontBodySemiBold}" FontSize="11"
                     Foreground="{DynamicResource Muted}" Margin="4,2,4,8"/>

          <RadioButton x:Name="OptNeon" Style="{StaticResource SwatchOption}" Click="OnPick" Tag="CyberpunkNeon">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3EC4FF" Offset="0"/>
                    <GradientStop Color="#E64FD9" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Cyberpunk Neon" FontFamily="{StaticResource FontBody}" FontSize="13.5"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="OptStealth" Style="{StaticResource SwatchOption}" Click="OnPick" Tag="StealthRed">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E5484D" Offset="0"/>
                    <GradientStop Color="#C7C3C0" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Stealth Red" FontFamily="{StaticResource FontBody}" FontSize="13.5"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="OptArctic" Style="{StaticResource SwatchOption}" Click="OnPick" Tag="ArcticPro">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2F6FED" Offset="0"/>
                    <GradientStop Color="#1E93A8" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Arctic Pro" FontFamily="{StaticResource FontBody}" FontSize="13.5"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="OptPrism" Style="{StaticResource SwatchOption}" Click="OnPick" Tag="PrismRgb">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="14" Height="14" Margin="0,0,8,0">
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4FA1FF" Offset="0"/>
                    <GradientStop Color="#E64FD9" Offset="0.55"/>
                    <GradientStop Color="#FF9D4D" Offset="1"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock Text="Prism RGB" FontFamily="{StaticResource FontBody}" FontSize="13.5"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
