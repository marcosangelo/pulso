<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grafite quase preto, mono branco/cinza, um único acento vermelho pra marca/tab ativa/crítico. -->

  <Color x:Key="BgColor">#121110</Color>
  <Color x:Key="CardColor">#1A1817</Color>
  <Color x:Key="FieldColor">#221F1E</Color>
  <Color x:Key="FieldHoverColor">#2C2827</Color>
  <Color x:Key="LineColor">#3A3634</Color>
  <Color x:Key="TextColor">#F5F3F2</Color>
  <Color x:Key="MutedColor">#9C9895</Color>
  <Color x:Key="AccentColor">#E5484D</Color>
  <Color x:Key="OkColor">#4DBE8C</Color>
  <Color x:Key="WarnColor">#D9A441</Color>
  <Color x:Key="HotColor">#E5484D</Color>
  <Color x:Key="OffColor">#615D5A</Color>
  <!-- Sem hue de identidade por métrica aqui — os 4 gauges primários ficam mono (cinza-claro). -->
  <Color x:Key="AccentCpuColor">#C7C3C0</Color>
  <Color x:Key="AccentGpuColor">#C7C3C0</Color>
  <Color x:Key="AccentRamColor">#C7C3C0</Color>
  <Color x:Key="AccentDiskColor">#C7C3C0</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="Field" Color="{StaticResource FieldColor}"/>
  <SolidColorBrush x:Key="FieldHover" Color="{StaticResource FieldHoverColor}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
  <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="Hot" Color="{StaticResource HotColor}"/>
  <SolidColorBrush x:Key="Off" Color="{StaticResource OffColor}"/>

  <SolidColorBrush x:Key="AccentCpu" Color="{StaticResource AccentCpuColor}"/>
  <SolidColorBrush x:Key="AccentGpu" Color="{StaticResource AccentGpuColor}"/>
  <SolidColorBrush x:Key="AccentRam" Color="{StaticResource AccentRamColor}"/>
  <SolidColorBrush x:Key="AccentDisk" Color="{StaticResource AccentDiskColor}"/>

</ResourceDictionary>
